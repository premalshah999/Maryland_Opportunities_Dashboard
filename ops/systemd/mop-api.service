[Unit]
Description=Maryland Opportunity Project API (FastAPI)
After=network.target

[Service]
Type=simple
User=bmgtmopadmin
Group=bmgtmopadmin
WorkingDirectory=/opt/mop/app
EnvironmentFile=-/etc/mop/mop.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/mop/venv/bin/gunicorn backend.main:app \
  --worker-class uvicorn.workers.UvicornWorker \
  --bind 127.0.0.1:8000 \
  --workers 2 \
  --timeout 120 \
  --graceful-timeout 30 \
  --keep-alive 5 \
  --access-logfile - \
  --error-logfile -

Restart=always
RestartSec=3

# Hardening (reasonable defaults; can be relaxed if needed)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/data/mop

[Install]
WantedBy=multi-user.target

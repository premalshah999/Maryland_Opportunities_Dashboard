[Unit]
Description=Maryland Opportunity Project API (FastAPI)
After=network.target

[Service]
Type=simple
User=bmgtmopadmin
Group=bmgtmopadmin
WorkingDirectory=/opt/mop/app
EnvironmentFile=-/etc/mop/mop.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/mop/venv/bin/gunicorn -c /etc/mop/gunicorn.conf.py backend.main:app

Restart=always
RestartSec=3

# Hardening (reasonable defaults; can be relaxed if needed)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/data/mop

[Install]
WantedBy=multi-user.target
